# Identificador de Instagram (lámina 8, paso 2) — informativo, no lo usa el servidor directamente.
META_IG_USER_ID=

# Clave de acceso de Instagram (lámina 8, paso 4)
META_PAGE_ACCESS_TOKEN=

# Clave secreta de la app (lámina 8, paso 2) — no la usa el servidor todavía, se deja
# reservada para cuando se valide la firma de las peticiones de Meta.
META_APP_SECRET=

# Cualquier string inventado por ti — se usa para verificar el webhook (lámina 8, paso 6)
META_VERIFY_TOKEN=

# Tu API key de Google AI / Gemini (aistudio.google.com/apikey) — tiene un tier gratis
# generoso para gemini-2.5-flash, ver Lámina 3
GEMINI_API_KEY=

# Opcional — modelo de Gemini a usar (default: gemini-2.5-flash)
GEMINI_MODEL=

# Tu Prompt Maestro ya personalizado (lámina 6), pegado completo como una sola variable
SYSTEM_PROMPT=

# Opcional — nombre de tu negocio, se usa solo para la página /privacy
BUSINESS_NAME=
