# Estas son las únicas 4 variables obligatorias — Vercel las detecta de este archivo
# al hacer "Import", así que solo debe aparecer aquí lo que el servidor usa de verdad.

# Clave de acceso de Instagram (lámina 8, paso 4)
META_PAGE_ACCESS_TOKEN=

# Cualquier string inventado por ti — se usa para verificar el webhook (lámina 8, paso 6)
META_VERIFY_TOKEN=

# Tu API key de Google AI / Gemini (aistudio.google.com/apikey) — tiene un tier gratis
# generoso para gemini-2.5-flash, ver Lámina 3
GEMINI_API_KEY=

# Tu Prompt Maestro ya personalizado (lámina 6), pegado completo como una sola variable
SYSTEM_PROMPT=

# --- Opcionales, puedes dejarlas vacías ---

# Modelo de Gemini a usar (default si se deja vacío: gemini-2.5-flash)
GEMINI_MODEL=

# Nombre de tu negocio, se usa solo para personalizar la página /privacy
BUSINESS_NAME=
